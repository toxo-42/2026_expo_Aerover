import socket, struct, io, time
from picamera2 import Picamera2
from picamera2.encoders import JpegEncoder
from picamera2.outputs import FileOutput

PORT = 5001

picam2 = Picamera2()
picam2.configure(picam2.create_video_configuration(main={"size": (1280, 720)}))


class SockOutput(io.BufferedIOBase):
    def __init__(self, conn, flag):
        self.conn = conn
        self.flag = flag

    def write(self, buf):
        try:
            self.conn.sendall(struct.pack("!I", len(buf)) + buf)
        except (BrokenPipeError, ConnectionResetError, OSError):
            self.flag[0] = False


srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
srv.bind(("0.0.0.0", PORT))
srv.listen(1)
print(f"대기 중... (포트 {PORT})", flush=True)

while True:
    conn, addr = srv.accept()
    print("연결:", addr, flush=True)
    alive = [True]

    try:
        picam2.start_recording(JpegEncoder(q=80), FileOutput(SockOutput(conn, alive)))
        while alive[0]:
            time.sleep(0.2)
    except Exception as e:
        print("오류:", e, flush=True)
    finally:
        try:
            picam2.stop_recording()
        except Exception:
            pass
        try:
            conn.close()
        except Exception:
            pass
        print("연결 끊김, 재대기", flush=True)
